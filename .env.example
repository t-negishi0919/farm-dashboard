# Google Sheets (read-only) ----------------------------------------------
# サービスアカウントの認証情報。Modal の google-sheets シークレットと同じ。
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_CLIENT_EMAIL=your_service_account@xxx.iam.gserviceaccount.com
# 改行は \n エスケープでも実改行でも可
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cloudinary（生育・不調写真の表示用、任意） ----------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 認証 (NextAuth / Auth.js v5) ----------------------------------------------
# AUTH_SECRET は `openssl rand -base64 32` で生成
AUTH_SECRET=your_random_secret_base64
# Google Cloud Console → OAuth 2.0 Credentials で作成
AUTH_GOOGLE_ID=xxxx-yyyy.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
# ログインを許可するメールアドレス (カンマ区切り)
ALLOWED_EMAILS=negishi.farm0708@gmail.com

# テスト時のみ。middleware を無効化して認証をスキップさせる(本番では未設定にする)
# SKIP_AUTH=1
